# ==============================================================================
# CropDoctor Environment Configuration
# ==============================================================================

# --- Frontend (Client-accessible via VITE_*) ---
# Your Supabase Project URL and Public Anon Key (Found in Supabase Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Optional OpenWeatherMap API Key (Free tier 1,000 calls/day: https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key

# Optional hCaptcha Site Key for bot & SMS rate limit protection (https://www.hcaptcha.com)
VITE_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key

# Optional Demo / Mock Mode override ('true' to enable local instant demo inference without external APIs)
VITE_ENABLE_OFFLINE_DEMO=true

# --- Backend / Supabase Edge Functions (Server-side ONLY — Never in frontend bundle) ---
# Supabase Service Role Key (Found in Supabase Settings > API > service_role secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Hugging Face User Access Token (Free tier: https://huggingface.co/settings/tokens)
HUGGINGFACE_API_TOKEN=hf_your_huggingface_access_token

# Optional: Custom Hugging Face Model ID (Defaults to PlantVillage image-classification model)
HUGGINGFACE_MODEL_ID=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# Optional: Kindwise Crop.Health API Key (Secondary high-accuracy provider, 10 free scans/mo)
KINDWISE_API_KEY=your_kindwise_api_key
ENABLE_KINDWISE_FALLBACK=false

# Optional: SMS Gateway Credentials for Supabase Phone OTP (e.g. MSG91 or Twilio)
# Configure directly in Supabase Dashboard > Authentication > Providers > Phone
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=CRPDOC

# Optional: LibreTranslate Endpoint (Dynamic translation fallback)
LIBRETRANSLATE_URL=https://translate.argosopentech.com
LIBRETRANSLATE_API_KEY=
